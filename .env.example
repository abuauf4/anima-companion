# ============================================================
# Anima Companion — Environment Variables Example
# Copy to .env (local) or set in Vercel dashboard (production)
# ============================================================

# === DATABASE (Phase 3 — Neon PostgreSQL migration readiness) ===
#
# Two connection strings are required:
#
# 1. DATABASE_URL  — Neon pooled runtime endpoint (host with -pooler suffix).
#    Used by the Next.js runtime (Prisma Client) for all app queries.
#    Get this from Neon Dashboard → Project → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL — Neon direct endpoint (host WITHOUT -pooler suffix).
#    Used by `prisma migrate`, `prisma db push`, `prisma studio`, `prisma introspect`,
#    `prisma validate`, `pg_dump`/`psql restore`, and any admin tooling that needs
#    a long-lived connection.
#    Get this from Neon Dashboard → Project → Connection Details → "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Notes:
#   - .env is gitignored and NOT tracked in git (untracked via `git rm --cached`).
#   - Never commit real connection strings. The values above use placeholders.
#   - Production secrets are set in Coolify (or Vercel) project env vars, not in this file.
#   - If you ever paste a real URL here by mistake, rotate the password in the
#     provider dashboard immediately and rewrite history.
#   - Neon pooler defensive params (pgbouncer, connection_limit, pool_timeout,
#     prepared_statements) are NOT set by default. Only add them if runtime
#     testing shows actual need (e.g. "prepared statement does not exist" errors
#     under load) — don't pre-bake defensive config that may not be required.
#   - Local dev: set both vars to a Neon dev branch (or local Docker postgres)
#     in .env (not .env.example). SQLite `file:` URLs are NOT supported because
#     prisma/schema.prisma uses provider="postgresql" (keeps dev/prod parity).
#   - Migration source (Supabase, paused): to dump the existing Supabase
#     production database, the owner provides the Supabase direct connection
#     string out-of-band. It must never be committed to the repo or written
#     into chat logs.

# === AUTH ===
# Random secret for signing session cookies (7-day expiry, HMAC-SHA-256).
# Generate with: openssl rand -hex 32
#
# IMPORTANT: AUTH_SECRET MUST be set in every production deployment.
# src/lib/auth.ts throws at module-load time when NODE_ENV === 'production'
# and AUTH_SECRET is missing — the server will refuse to start rather than
# fall back to a known dev secret. Set this in your deployment platform
# (Coolify / Vercel project env vars) BEFORE promoting a build.
# AUTH_SECRET is server-only; never prefix it with NEXT_PUBLIC_.
AUTH_SECRET="generate-a-random-32-hex-string-here"

# === NODE ENV (auto-set by Vercel) ===
# NODE_ENV="production"  # Vercel sets this automatically

# === SEO — Canonical & Indexing (Phase 1.1) ===
# Official canonical production domain. MUST be https://animacompanion.id on
# every deployment (production AND staging AND local). This is the absolute
# origin used for canonical URLs, OG URLs, JSON-LD `url` fields, the sitemap,
# and robots.txt host directive. Never set this to a staging/preview/Vercel/
# Coolify/VPS-IP URL — staging is excluded from indexing via ALLOW_INDEXING
# below, NOT by changing the canonical.
NEXT_PUBLIC_SITE_URL="https://animacompanion.id"

# Whether this deployment may be indexed by search engines.
#   "true"  → production only (https://animacompanion.id)
#   "false" (or unset) → staging / preview / local / any non-production
#
# When this is NOT "true", the app forces noindex,nofollow sitewide (in root
# metadata) AND robots.txt disallows all crawling AND the sitemap is not
# advertised. Canonical URLs still point to https://animacompanion.id.
#
# ⚠️  CRITICAL — NEXT_PUBLIC_* vars are inlined at BUILD time, not runtime.
# This means the value present when `next build` runs is what gets baked
# into the static HTML. Set this at build time, not at server-start time:
#
#   # Staging build (default safe — non-indexable):
#   bun run build
#   # or explicit:
#   NEXT_PUBLIC_ALLOW_INDEXING=false bun run build
#
#   # Production build (indexable — only on https://animacompanion.id):
#   NEXT_PUBLIC_ALLOW_INDEXING=true bun run build
#
# The safe default is `false` — if the var is missing or wrongly set on a
# staging/preview build, that deployment will simply not be indexed, which
# is always recoverable. The reverse (accidentally indexing staging) is not.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# === CLOUDINARY (admin product image uploads) ===
#
# Cloudinary is used ONLY for new product images uploaded from the Admin UI
# (admin form's "Upload Foto" button). Existing local images under
# /public/products/<slug>/*.webp are kept as-is and continue to work — the
# two URL types are interchangeable in the ProductImage.url column.
#
# The browser uploads image bytes DIRECTLY to Cloudinary via signed-upload.
# Our server only generates the signature using the API_SECRET; the secret
# itself never reaches the browser. See src/lib/cloudinary.ts.
#
# Required to enable admin uploads:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# Server-only — NEVER expose via NEXT_PUBLIC_*:
CLOUDINARY_API_SECRET=""
# If left empty, the Admin upload UI shows "Cloudinary belum dikonfigurasi"
# and the manual URL paste fallback remains available.
#
# New uploads land in the Cloudinary folder: anima/products/

