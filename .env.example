# ============================================================
# Anima Companion — Environment Variables Example
# Copy to .env (local) or set in Vercel dashboard (production)
# ============================================================

# === DATABASE (Phase 3 — Neon PostgreSQL migration readiness) ===
#
# Two connection strings are required:
#
# 1. DATABASE_URL  — Neon POOLED connection (PgBouncer transaction mode).
#    Used by the Next.js runtime (Prisma Client) for all app queries.
#    Get this from Neon Dashboard → Project → Connection Details → "Pooled connection".
#    Format:
#      postgresql://<user>:<password>@<ep-host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=60&prepared_statements=false
#    Required params:
#      sslmode=require              — Neon requires TLS.
#      pgbouncer=true               — required for Neon pooled endpoint.
#      connection_limit=1           — serverless-friendly (1 conn per Prisma client).
#      pool_timeout=60              — avoid hard failures under burst load.
#      prepared_statements=false    — PgBouncer transaction mode doesn't support them.
DATABASE_URL="postgresql://USER:PASSWORD@ep-project-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=60&prepared_statements=false"

# 2. DIRECT_URL — Neon DIRECT connection (no pooler).
#    Used by `prisma migrate`, `prisma db push`, `prisma studio`, `prisma introspect`,
#    `prisma validate`, and any admin tooling that needs a long-lived connection.
#    Get this from Neon Dashboard → Project → Connection Details → "Direct connection".
#    Format:
#      postgresql://<user>:<password>@<ep-host>.<region>.aws.neon.tech/<db>?sslmode=require
#    Do NOT add pgbouncer params here — the direct endpoint bypasses PgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@ep-project.region.aws.neon.tech/neondb?sslmode=require"

# Local dev:
#   Set both vars to a Neon dev branch (or a local Docker postgres) in .env (not .env.example).
#   The old local SQLite `file:` URL is no longer supported because prisma/schema.prisma
#   uses provider="postgresql" (Phase 3 cleanup — keeps dev/prod parity, avoids drift).
#
# Migration source (Supabase, paused):
#   To dump the existing Supabase production database, use the Supabase direct
#   (non-pooled) connection string — NOT the values above. That connection string
#   is provided by the owner out-of-band and must never be committed to the repo
#   or written into chat logs.
#
# Credentials hygiene:
#   - .env is gitignored.
#   - Never commit real connection strings. The values above use placeholders.
#   - Production secrets are set in Coolify (or Vercel) project env vars, not in this file.
#   - If you ever paste a real URL here by mistake, rotate the password in the
#     provider dashboard immediately and rewrite history.

# === AUTH ===
# Random secret for signing JWT session cookies (7-day expiry)
# Generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-random-32-hex-string-here"

# === NODE ENV (auto-set by Vercel) ===
# NODE_ENV="production"  # Vercel sets this automatically

# === SEO — Canonical & Indexing (Phase 1.1) ===
# Official canonical production domain. MUST be https://animacompanion.id on
# every deployment (production AND staging AND local). This is the absolute
# origin used for canonical URLs, OG URLs, JSON-LD `url` fields, the sitemap,
# and robots.txt host directive. Never set this to a staging/preview/Vercel/
# Coolify/VPS-IP URL — staging is excluded from indexing via ALLOW_INDEXING
# below, NOT by changing the canonical.
NEXT_PUBLIC_SITE_URL="https://animacompanion.id"

# Whether this deployment may be indexed by search engines.
#   "true"  → production only (https://animacompanion.id)
#   "false" (or unset) → staging / preview / local / any non-production
#
# When this is NOT "true", the app forces noindex,nofollow sitewide (in root
# metadata) AND robots.txt disallows all crawling AND the sitemap is not
# advertised. Canonical URLs still point to https://animacompanion.id.
#
# ⚠️  CRITICAL — NEXT_PUBLIC_* vars are inlined at BUILD time, not runtime.
# This means the value present when `next build` runs is what gets baked
# into the static HTML. Set this at build time, not at server-start time:
#
#   # Staging build (default safe — non-indexable):
#   bun run build
#   # or explicit:
#   NEXT_PUBLIC_ALLOW_INDEXING=false bun run build
#
#   # Production build (indexable — only on https://animacompanion.id):
#   NEXT_PUBLIC_ALLOW_INDEXING=true bun run build
#
# The safe default is `false` — if the var is missing or wrongly set on a
# staging/preview build, that deployment will simply not be indexed, which
# is always recoverable. The reverse (accidentally indexing staging) is not.
NEXT_PUBLIC_ALLOW_INDEXING="false"
