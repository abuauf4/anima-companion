# Local development environment (gitignored — do NOT commit real values).
#
# Phase 3 (Neon migration readiness):
# Both DATABASE_URL and DIRECT_URL must be set. Replace the placeholders below
# with a Neon dev branch connection string (recommended) or a local Docker
# postgres connection string.
#
# The previous `DATABASE_URL=file:...` (SQLite) is no longer supported because
# prisma/schema.prisma uses provider="postgresql". Dev/prod parity avoids drift.
#
# Local dev pattern (Neon dev branch example):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-project-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=60&prepared_statements=false"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-project.region.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@ep-project-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=60&prepared_statements=false"
DIRECT_URL="postgresql://USER:PASSWORD@ep-project.region.aws.neon.tech/neondb?sslmode=require"
