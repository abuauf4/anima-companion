// Anima Companion — Prisma Schema
// PostgreSQL untuk dev & production (Supabase / Neon / Vercel Postgres).
//
// Phase 3 (Neon migration readiness):
// - `url`       → DATABASE_URL  (Neon pooled connection via PgBouncer, for runtime)
// - `directUrl` → DIRECT_URL    (Neon direct connection, for migrations/introspection/admin)
// Prisma 6.x supports `directUrl` natively (introduced in 5.10). Both env vars
// MUST be set in production. See `.env.example` for the correct format.
//
// ===========================================================================
// SCHEMA DEPLOYMENT STRATEGY — schema-push (prisma db push), NOT migrations
// ===========================================================================
// This project intentionally uses the schema-push workflow
// (`bun run db:push` → `prisma db push`) instead of the migration workflow
// (`prisma migrate dev` / `prisma migrate deploy`). There is intentionally
// NO `prisma/migrations/` directory and NO `_prisma_migrations` table.
//
// WHY (historical context, see worklog.md Phase 3):
//   - The existing Supabase production database was the source of truth
//     at the time of the Neon migration readiness work. The schema was
//     introspected against production, compared with this file, and
//     pushed with `prisma db push` to align dev/staging/prod to the
//     same shape. Generating a synthetic migration baseline from a
//     pre-existing database is fragile and `prisma migrate` would have
//     falsely recorded a sequence of `migration.sql` files that never
//     actually ran in order on the production DB.
//   - The team chose to keep `prisma db push` going forward and to
//     document schema-level changes via commit history + the SQL
//     reference files in `prisma/sql/` rather than via `_prisma_migrations`.
//
// WHAT THIS MEANS FOR OPERATORS:
//   - To apply schema changes to any environment (dev/staging/prod),
//     run `bun run db:push` (or `bunx prisma db push` against the
//     target DATABASE_URL). Prisma will compute the diff between this
//     schema file and the target DB and apply the minimal DDL.
//   - The `db:migrate` script (`prisma migrate dev`) exists in
//     package.json but is intentionally unused. Running it would
//     create a `prisma/migrations/` directory and a `_prisma_migrations`
//     table on the target DB, which would conflict with the schema-push
//     workflow. Do NOT switch workflows without a coordinated migration
//     plan that exports the existing DB state as the baseline migration.
//   - For audit / paper-trail purposes, every schema-affecting commit
//     SHOULD also commit a corresponding SQL reference file under
//     `prisma/sql/<YYYYMMDD>-<slug>.sql` showing the DDL that `db push`
//     would have applied. These files are NOT Prisma migrations and are
//     NOT picked up by `prisma migrate` — they exist purely so an
//     operator can review / replay the DDL by hand if needed.
//
// VERIFICATION (how to verify schema parity without running migrations):
//   - `bunx prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-url $DATABASE_URL`
//     prints the SQL that `db push` WOULD apply to bring the target DB
//     in line with the schema. If the output is empty, the DB is already
//     in sync. Use this in CI / pre-deploy checks.
//   - `bunx prisma migrate diff --from-url $DATABASE_URL --to-schema-datamodel prisma/schema.prisma`
//     prints the inverse diff — useful for detecting drift in the other
//     direction (DB has columns the schema doesn't, or vice versa).
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== USER & AUTH ====================
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  phone           String?
  role            String   @default("CUSTOMER") // CUSTOMER | ADMIN | SELLER
  // === Verified Identity V1 ===
  // Identity provider for this account:
  //   PASSWORD — local email/password (default, backwards-compatible with
  //              existing rows created before Verified Identity V1).
  //   GOOGLE   — account created via Google Sign-In; email is considered
  //              verified by Google's identity-provider assertion.
  provider        String   @default("PASSWORD")
  // For GOOGLE users: the stable Google `sub` claim. NULL for PASSWORD
  // users. Unique when set, so a single Google identity can map to at
  // most one Anima Companion account.
  providerSubject  String?  @unique
  // Authoritative email-verification timestamp. NULL means unverified.
  // For PASSWORD users this is set ONLY by the email-verification flow
  // (POST /api/auth/verify-email/confirm with a valid token). For GOOGLE
  // users this is set at account-creation time, because Google's
  // `email_verified` claim is the trusted authority.
  // NEVER set this from a client request body — only from trusted server
  // flows (token verification / OAuth callback).
  emailVerifiedAt  DateTime?
  // === Account Recovery & Verification V2 ===
  // Monotonically-increasing version number for the user's session
  // authority. Encoded into the HMAC session cookie at sign time and
  // re-checked at every `getCurrentUser()` call. Bumped on password reset
  // (and any other credential-changing event) so all sessions issued
  // before the bump are immediately invalid — the user must re-authenticate
  // with the new credentials. Defaults to 0 so existing rows are
  // backwards-compatible. NEVER read from a client request body — only
  // the server-side reset-password flow increments this.
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart             Cart?
  orders           Order[]
  reviews          Review[]
  petProfiles      PetProfile[]
  wishlist         Wishlist[]
  seller           Seller?
  verificationTokens EmailVerificationToken[]
  otpCodes         OtpCode[]
  passwordResetGrants PasswordResetGrant[]
}

// ==================== ADMIN REALM (V1 — Developer RBAC) ====================
//
// SEPARATE IDENTITY REALM for internal admin users. This is intentionally
// a DIFFERENT table from `User` (the customer/member registry) so that:
//   - Customer auth (`anima_session` cookie, /api/auth/* routes, OTP, Google
//     OAuth, forgot/reset-password, member registry) is fully decoupled
//     from internal admin auth.
//   - An admin session (`anima_admin_session` cookie) CANNOT be derived
//     from a customer session and vice versa — the two realms use
//     different cookie names AND different DB tables.
//   - Customer data (orders, carts, wishlists, pet-profiles) stays in the
//     `User` registry; admin actions are auditable via `AdminUser`.
//
// SECURITY CONTRACT — never break these invariants:
//   - `passwordHash` is the ONLY password field. The plaintext password
//     is NEVER stored, NEVER logged, NEVER returned by any API. The
//     DEVELOPER who creates an admin sets a TEMPORARY password that the
//     admin MUST change on first login (`mustChangePassword = true`).
//   - `systemRole` is one of: DEVELOPER | ADMIN. DEVELOPER is the highest
//     privilege level and bypasses ALL permission checks. ADMIN must be
//     granted explicit `AdminPermission` rows.
//   - `sessionVersion` works exactly like `User.sessionVersion` — encoded
//     into the HMAC admin session cookie at sign time, re-checked on every
//     request. Bumped on password change/reset so all prior sessions are
//     invalidated immediately.
//   - `mustChangePassword = true` blocks access to ALL admin panels except
//     `/admin/change-password`. The admin session IS issued (so they can
//     reach the change-password page) but every other admin route rejects
//     them with 403 MUST_CHANGE_PASSWORD.
//   - `isActive = false` blocks login AND invalidates existing sessions
//     (the session re-fetches `isActive` from the DB on every request —
//     never trusts the cookie).
//   - `createdByAdminId` is a self-referential FK to the AdminUser who
//     created this admin. Nullable for the bootstrap DEVELOPER (who was
//     created from env vars, not by another admin).
//   - A DEVELOPER account CANNOT be deleted, deactivated, or have its
//     role downgraded by an ADMIN — enforced server-side in the
//     admin-users API (not just hidden in the UI).
//
// PERMISSION MODEL (V1 — coarse-grained, keyed on real admin menu items):
//   AdminPermission rows are (adminUserId, permissionKey) pairs where
//   permissionKey is one of PERMISSION_KEYS in src/lib/admin-permissions.ts.
//   DEVELOPER bypasses all permission checks. ADMIN gets only the keys
//   present in their AdminPermission set. No wildcards, no inheritance,
//   no role hierarchy beyond DEVELOPER > ADMIN.
model AdminUser {
  id                String   @id @default(cuid())
  // Username for /admin/login. CASE-INSENSITIVE lookup at login time
  // (we normalize to lower-case before both insert and findUnique), but
  // the column is case-sensitive UNIQUE so two admins cannot differ
  // only by case. Stored lower-case to make the unique constraint
  // behavior predictable.
  username          String   @unique
  passwordHash      String
  displayName       String
  // DEVELOPER | ADMIN. DEVELOPER is the highest privilege level.
  // NEVER trust a client-supplied value for this field — the
  // create-admin API hardcodes 'ADMIN' and only the bootstrap seed
  // (env-var-driven, no public API) can create a DEVELOPER.
  systemRole        String   @default("ADMIN")
  isActive          Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  sessionVersion    Int      @default(0)
  // Self-referential FK to the admin who created this admin. NULL for
  // the bootstrap DEVELOPER (created from env vars, not by another admin).
  createdByAdminId  String?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permissions       AdminPermission[]
  createdBy         AdminUser? @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAdmins     AdminUser[] @relation("AdminCreatedBy")

  @@index([createdByAdminId])
}

// ==================== ADMIN PERMISSIONS (V1 RBAC) ====================
//
// Granular permission keys for ADMIN users. DEVELOPER bypasses all checks
// (see src/lib/admin-auth.ts → requirePermission).
//
// PERMISSION_KEYS is the authoritative list — defined in
// src/lib/admin-permissions.ts so the lib + tests can import it without
// duplicating string literals. The DB does NOT enforce membership in
// PERMISSION_KEYS (that would require an enum or check constraint per
// key, which is brittle to evolve) — instead, the create/update-admin
// API rejects unknown keys before writing.
//
// UNIQUE (adminUserId, permissionKey) — an admin either has a key or
// doesn't; duplicates are not allowed.
model AdminPermission {
  id            String   @id @default(cuid())
  adminUserId   String
  permissionKey String

  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permissionKey])
  @@index([adminUserId])
}

// ==================== EMAIL VERIFICATION TOKENS ====================
// Single-use, time-limited tokens for proving control of an email address
// during PASSWORD registration. GOOGLE users do not use this table — their
// email is verified by Google's identity provider at account-creation
// time and `emailVerifiedAt` is set directly.
//
// SECURITY CONTRACT:
//   - The raw token is 32 bytes of CSPRNG output, hex-encoded (64 chars).
//   - The DB stores only `sha256(rawToken)` as `tokenHash` — a DB
//     compromise does NOT reveal active tokens.
//   - `expiresAt` is 24h after creation.
//   - `consumedAt` is NULL until the token is consumed by the verify
//     route. Once non-NULL the token can never be used again.
//   - On requesting a new verification email, all UNCONSUMED tokens for
//     the same user are invalidated by setting `consumedAt = now()` —
//     only the newest token is valid at any time.
//   - Concurrency-safe consumption: the verify route uses
//     `updateMany WHERE consumedAt IS NULL AND expiresAt > now()` and
//     checks `count === 1` — only one of two concurrent requests with
//     the same token can win. The loser returns the same success
//     response (idempotent outcome: `emailVerifiedAt` is set either way).
model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  // SHA-256 hex of the raw 32-byte token. Never store the raw token.
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  // ---------------------------------------------------------------------
  // SCHEMA DRIFT RECONCILIATION (2026-08-22, Variants V1 db-apply prep).
  //
  // The production DB has had these 3 columns since the V2 account-recovery
  // rollout, but they were never added to `schema.prisma` — they were
  // applied directly to the DB (likely via an early V2 SQL script that
  // has since been lost / superseded). The current application code in
  // `src/lib/identity.ts` does NOT read or write these columns — they
  // are dead columns from the app's perspective, but they MUST be declared
  // here so that `prisma db push` does not try to DROP them (which would
  // be a destructive data-loss operation on the 1 existing row).
  //
  // Exact DB definitions (verified via information_schema.columns on
  // ep-gentle-star-aza63vyg, 2026-08-22):
  //   attemptCount  integer NOT NULL DEFAULT 0
  //   lastSentAt    timestamp(3) NULL
  //   purpose       text NOT NULL DEFAULT 'EMAIL_VERIFY'
  //
  // Index (verified via pg_indexes):
  //   EmailVerificationToken_userId_purpose_consumedAt_idx
  //     btree (userId, purpose, consumedAt)
  //
  // These are kept AS-IS — no rename, no type change, no default change.
  // If a future cleanup phase wants to drop them, that must be a separate,
  // deliberate decision (with `--accept-data-loss` and a migration of
  // any historical data).
  // ---------------------------------------------------------------------
  attemptCount Int       @default(0)
  lastSentAt   DateTime?
  purpose      String    @default("EMAIL_VERIFY")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Composite index for the V2 lookup pattern: find the most recent
  // unconsumed token for a (userId, purpose) pair. Mirrors the
  // OtpCode_userId_purpose pattern but includes consumedAt so the
  // partial scan can short-circuit on consumedAt IS NULL.
  @@index([userId, purpose, consumedAt])
}

// ==================== OTP CODES (Account Recovery & Verification V2) ====================
// 6-digit one-time passwords for (a) email verification on new PASSWORD
// registrations and (b) password-reset identity proof. Replaces the V1
// link-based EmailVerificationToken flow for new issuances — V1 tokens
// already in the DB remain valid until consumed or expired, but new
// requests use this OTP table.
//
// SECURITY CONTRACT:
//   - The raw 6-digit code is NEVER stored. The DB stores only
//     `codeHash = HMAC-SHA-256(code, secret)` where `secret` is the
//     server's AUTH_SECRET (same secret used to sign session cookies).
//     HMAC (not plain SHA-256) is mandatory because the 6-digit code
//     space is only 10^6 — without a server-secret pepper, a DB-leak
//     attacker could brute-force the hash in microseconds. With the
//     HMAC pepper, the attacker must know AUTH_SECRET to mount even an
//     offline brute force.
//   - `purpose` discriminates email-verification OTPs from password-reset
//     OTPs so a code issued for one flow cannot be redeemed in the other.
//   - `attempts` counts failed verification attempts against this code.
//     When `attempts >= maxAttempts` (default 5), the code is LOCKED —
//     further verification attempts return `LOCKED` and the user must
//     request a new code (subject to the 60s resend cooldown).
//   - `expiresAt` is 10 minutes after creation (V2 spec).
//   - `lastSentAt` records when the most recent EMAIL carrying this code
//     was dispatched. The resend-cooldown check is
//     `now - lastSentAt < 60s` → reject the resend. This is enforced
//     server-side, not client-side, so a malicious client cannot bypass it.
//   - `consumedAt` is NULL until the code is successfully verified.
//     Once set, the code can never be used again — single-use enforcement.
//   - On requesting a new OTP, all UNCONSUMED OTPs for the same
//     (userId, purpose) pair are invalidated by setting `consumedAt = now()`
//     AND `attempts = maxAttempts` (so a partially-attacked old code can't
//     be revived). Only the newest OTP is valid at any time.
//   - Concurrency-safe consumption: the verify path uses an interactive
//     `db.$transaction(async (tx) => { ... })` that (1) looks up the
//     newest unconsumed OTP for the (userId, purpose) pair inside the tx,
//     (2) atomically claims it via `updateMany WHERE id = row.id AND
//     consumedAt IS NULL AND expiresAt > now AND attempts < maxAttempts`,
//     (3) GATES on `claim.count === 1` — if the claim lost the race (a
//     concurrent verify won it, or a new OTP was issued between lookup
//     and claim, or the code expired between lookup and claim, or the
//     attempts just hit maxAttempts), NO further mutation happens.
//     Only when `claim.count === 1` does the verify proceed to its
//     purpose-specific side effect (set emailVerifiedAt, or issue a
//     PasswordResetGrant).
//   - On a WRONG code (hash mismatch), `attempts` is incremented inside
//     the SAME transaction. Two concurrent wrong-code requests can race,
//     but the `updateMany WHERE id = row.id AND attempts < maxAttempts`
//     re-asserts the cap atomically — when attempts hits maxAttempts,
//     further wrong-code requests return LOCKED without incrementing
//     past the cap. The cap is hard.
model OtpCode {
  id          String    @id @default(cuid())
  userId      String
  // 'EMAIL_VERIFICATION' | 'PASSWORD_RESET'. Discriminates the two OTP
  // flows so a code issued for one cannot be redeemed in the other.
  purpose     String
  // HMAC-SHA-256(code, AUTH_SECRET) — hex digest. The raw 6-digit code
  // is NEVER persisted. See the SECURITY CONTRACT above for why HMAC
  // (not plain SHA-256) is mandatory for a 6-digit code space.
  codeHash    String
  // Failed verification attempts against THIS code. When this reaches
  // `maxAttempts`, the code is LOCKED — the user must request a new one.
  attempts    Int       @default(0)
  // Denormalized cap (default 5) for auditability — could be tuned per
  // purpose in the future without a schema change.
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  // NULL until successfully consumed (single-use enforcement).
  consumedAt  DateTime?
  // When the most recent EMAIL carrying this code was dispatched. The
  // 60-second resend cooldown is `now - lastSentAt < 60s`.
  lastSentAt  DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])

  // ---------------------------------------------------------------------
  // DB-LEVEL BACKSTOP INDEX (applied via raw SQL — see
  // prisma/sql/20260815-otp-active-uniq-backstop.sql):
  //
  //   CREATE UNIQUE INDEX "OtpCode_userId_purpose_active_uniq"
  //     ON "OtpCode"("userId", "purpose")
  //     WHERE "consumedAt" IS NULL;
  //
  // Prisma's schema language does NOT support partial unique indexes
  // with a WHERE clause, so this index is NOT expressed in the schema.
  // It is applied via raw SQL after `prisma db push`. Prisma's `db push`
  // preserves it across re-pushes (verified empirically on the QA DB).
  //
  // This index enforces the invariant "at most ONE unconsumed OTP per
  // (userId, purpose)" at the DB level, as defense-in-depth behind the
  // PRIMARY serialization mechanism (`pg_advisory_xact_lock` acquired
  // inside `issueOtp`'s interactive transaction — see src/lib/otp.ts).
  //
  // The predicate is `consumedAt IS NULL` ONLY — it does NOT include
  // `expiresAt > NOW()` because PostgreSQL partial-index predicates
  // must be immutable (cannot depend on volatile functions like NOW()).
  // Expired-but-unconsumed rows are handled by `issueOtp`'s invalidation
  // step (sets consumedAt = now on all prior unconsumed rows for the
  // same (userId, purpose) before inserting the replacement).
  // ---------------------------------------------------------------------
}

// ==================== PASSWORD RESET GRANTS (V2) ====================
// Short-lived, single-use grants issued AFTER a valid password-reset OTP
// consumption. The raw grant is a 32-byte CSPRNG hex string delivered
// to the user's email OR returned to the OTP-verify response (the route
// will decide; current V2 plan: returned in the verify-OTP response,
// then submitted by the reset-password form).
//
// SECURITY CONTRACT:
//   - The raw grant is 32 bytes of CSPRNG output, hex-encoded (64 chars).
//   - The DB stores only `sha256(rawGrant)` as `grantHash` — a DB
//     compromise does NOT reveal active grants. SHA-256 is sufficient
//     here (unlike the 6-digit OTP) because the input is 32 bytes of
//     CSPRNG entropy — already brute-force-infeasible.
//   - `expiresAt` is 10 minutes after creation (V2 spec — short-lived).
//   - `consumedAt` is NULL until the grant is consumed by the
//     reset-password route. Once set, the grant can never be used again.
//   - Concurrency-safe consumption: the reset-password route uses
//     `updateMany WHERE consumedAt IS NULL AND expiresAt > now()` and
//     checks `count === 1` — only one of two concurrent requests with
//     the same grant can win. The loser is rejected.
//   - On successful consumption, the route atomically (in the SAME
//     interactive transaction) (a) sets the new bcrypt password,
//     (b) bumps `User.sessionVersion` (invalidating all prior sessions),
//     (c) marks the grant as consumed.
//   - A successful password reset ALSO invalidates all unconsumed OTPs
//     for the user (any purpose) by setting `consumedAt = now()` — so
//     a partially-attacked password-reset OTP cannot be used after the
//     password is changed.
model PasswordResetGrant {
  id          String    @id @default(cuid())
  userId      String
  // SHA-256 hex of the raw 32-byte grant. Never store the raw grant.
  grantHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PetProfile {
  id        String   @id @default(cuid())
  userId    String
  petName   String
  petTypeId String
  age       String   // "2 tahun" / "6 bulan"
  weight    String   // "4.5 kg"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petType   PetType  @relation(fields: [petTypeId], references: [id])

  @@index([userId])
}

// ==================== SELLER / BRAND (MARKETPLACE) ====================
model Seller {
  id          String   @id @default(cuid())
  userId      String?  @unique // jika seller punya akun login
  name        String   // nama brand/toko
  slug        String   @unique
  logo        String?
  banner      String?
  tagline     String?
  description String?
  rating      Float    @default(5.0)
  totalSales  Int      @default(0)
  location    String?
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  products    Product[]
}

// ==================== CATALOG ====================
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products  Product[]
}

model PetType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products       ProductPetType[]
  petProfiles    PetProfile[]
}

model Problem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())

  products    ProductProblem[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  sku             String    @unique
  brand           String    // brand label (string, e.g. "Zesty Paws", "Native Pet")
  sellerId        String?   // relasi ke Seller (marketplace)
  price           Int       // dalam Rupiah penuh
  salePrice       Int?
  subscribePrice  Int?      // harga subscribe & save (lebih murah)
  stock           Int       @default(0)
  weight          String?
  description     String
  benefit         String
  usage           String
  ingredients     String
  bpomNumber      String?
  isBestSeller    Boolean   @default(false)
  isNew           Boolean   @default(false)
  isSubscribeEligible Boolean @default(false) // eligible untuk Subscribe & Save
  rating          Float     @default(5.0)
  reviewCount     Int       @default(0)
  isActive        Boolean   @default(true)
  // Product variant support (Phase: Variants).
  // When false (default for ALL existing products), the product behaves
  // exactly as before — `price`/`salePrice`/`stock` on the Product row are
  // the authoritative values.
  // When true, `variants[]` are the authoritative source for price/stock,
  // and the parent `price`/`salePrice`/`stock` are derived compatibility
  // caches (kept in sync by admin/order code so legacy readers don't break).
  hasVariants     Boolean   @default(false)
  categoryId      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id])
  seller          Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  petTypes        ProductPetType[]
  problems        ProductProblem[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlist        Wishlist[]
  variants        ProductVariant[]

  @@index([categoryId])
  @@index([slug])
  @@index([sellerId])
}

// ==================== PRODUCT VARIANT ====================
// One product can have zero or more variants (e.g. "10 kapsul", "30 kapsul",
// "60 ml"). Each variant has its own name, price, optional salePrice, and
// stock. Variants are independently added to cart and independently
// decremented at checkout.
//
// When `Product.hasVariants = true`:
//   - The parent Product's `price`/`salePrice`/`stock` become a derived
//     compatibility cache: `price` = lowest effective selling price across
//     active variants; `stock` = sum of active variant stocks. This cache is
//     recomputed by admin save and by checkout, so legacy homepage/list
//     readers that only read Product fields continue to work.
//   - Variant `stock` is the authoritative inventory for checkout.
//   - Variant `isActive=false` hides the variant from public APIs but
//     preserves the row (for historical OrderItem references via FK).
//
// When `Product.hasVariants = false` (default for all existing products):
//   - No ProductVariant rows exist for this product.
//   - Product.price/salePrice/stock are authoritative, as before.
model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  name        String
  price       Int
  salePrice   Int?
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPetType {
  productId String
  petTypeId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  petType   PetType  @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([productId, petTypeId])
}

model ProductProblem {
  productId String
  problemId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([productId, problemId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  userName  String
  rating    Int
  comment   String
  petType   String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ==================== CART & WISHLIST ====================
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  // Variant reference (Phase: Variants).
  // NULL for non-variant products (the default and only case for all
  // existing products). Non-NULL for variant products — different variants
  // of the same product are separate cart lines.
  variantId   String?
  quantity    Int      @default(1)
  isSubscribe Boolean  @default(false) // apakah item ini pakai subscribe & save
  createdAt   DateTime @default(now())

  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Unique constraint change: previously `@@unique([cartId, productId])`
  // enforced one cart line per product. With variants, the same product can
  // appear multiple times with different `variantId`. NULLs are distinct in
  // Postgres unique indexes, so two non-variant rows for the same product
  // would NOT collide at the DB level — we additionally rely on app-level
  // merge in `addItem` to keep non-variant cart items as a single line.
  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ==================== VOUCHER ====================
model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // PERCENTAGE | FIXED
  value       Int
  minSpend    Int       @default(0)
  isActive    Boolean   @default(true)
  validUntil  DateTime?
  description String?
  createdAt   DateTime  @default(now())
}

// ==================== ORDER ====================
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  userId        String?
  status        String   @default("PENDING")
  customerName  String
  customerPhone String
  address       String
  notes         String?
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  voucherCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  price       Int
  quantity    Int
  subtotal    Int
  // Variant snapshot (Phase: Variants).
  // NULL for non-variant products. For variant products, this captures the
  // variant identity AT ORDER TIME — `variantName` is a denormalized
  // snapshot so historical orders remain readable even if the variant is
  // later renamed or deleted. `variantId` is the FK to ProductVariant (SetNull
  // on variant deletion — preserves the order row, just loses the live link).
  variantId   String?
  variantName String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ==================== CONTENT ====================
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  link      String?
  position  String   @default("HOME")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  petName   String
  petType   String
  message   String
  rating    Int      @default(5)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
}

// ==================== SITE SETTINGS (SINGLETON) ====================
model SiteSetting {
  id                  String   @id @default("singleton")
  // Hero
  heroEyebrow         String   @default("Suplemen & Vitamin Hewan Peliharaan")
  heroTitle1          String   @default("Elevating")
  heroTitle2          String   @default("Animal Health")
  heroDescription     String   @default("Suplemen & vitamin hewan peliharaan premium dari Anima Companion — PT Sutan Vet Medika. Tersedia di 400+ klinik seluruh Indonesia.")
  heroHookTitle1      String   @default("Belanja sesuai")
  heroHookTitle2      String   @default("hewan peliharaanmu")
  // Trust badges
  trustBadge1Value    String   @default("50rb+")
  trustBadge1Label    String   @default("Pelanggan")
  trustBadge2Value    String   @default("400+")
  trustBadge2Label    String   @default("Klinik Resmi")
  trustBadge3Value    String   @default("4.9★")
  trustBadge3Label    String   @default("Rating")
  trustBadge4Value    String   @default("24/7")
  trustBadge4Label    String   @default("Konsul Vet")
  // Contact
  whatsappNumber      String   @default("6282210846408")
  email               String   @default("sutanvetmedika@gmail.com")
  instagram           String   @default("@anima.companion")
  instagramUrl        String   @default("https://instagram.com/anima.companion")
  shopeeUrl           String   @default("https://shopee.co.id/anima.companion")
  tokopediaUrl        String   @default("https://www.tokopedia.com/find/felcover")
  tiktokUrl           String   @default("")
  // Announcement bar
  announcement1       String   @default("🚚 Gratis ongkir min Rp 150.000")
  announcement2       String   @default("⏰ Flash Sale 20% — berakhir segera!")
  announcement3       String   @default("🎁 Subscribe & Save hemat 15% setiap pesanan")
  announcement4       String   @default("🩺 Konsultasi vet gratis 24/7 via WhatsApp")
  // Misc
  freeShippingThreshold Int     @default(150000)
  // Promo / Announcement campaign — configurable countdown bar above navbar.
  // All optional / defaulted so existing singleton rows migrate cleanly
  // (ADD COLUMN ... DEFAULT ... is non-blocking on a one-row table).
  //
  // Semantics:
  //   - When `promoActive = true` AND now is within [promoStartAt, promoEndAt]:
  //     the bar shows the "during" promo campaign (priority over rotating
  //     announcement1–4). Countdown ticks toward `promoEndAt`.
  //   - When `promoActive = true` AND now is before `promoStartAt`:
  //     the bar shows the "before" promo campaign. Countdown ticks toward
  //     `promoStartAt`.
  //   - When `promoActive = true` AND now is after `promoEndAt`:
  //     promo is over — bar AUTOMATICALLY falls back to rotating
  //     announcement1–4 behavior. No manual "end the promo" action needed.
  //   - When `promoActive = false`: bar shows rotating announcement1–4.
  //
  // Datetimes:
  //   - Admin input is interpreted as Asia/Jakarta (WIB, UTC+7) in the UI.
  //   - Stored as UTC DateTime in the DB (standard Prisma behavior).
  //   - Countdown math uses the absolute UTC milliseconds — no server or
  //     device timezone assumptions leak into the comparison.
  //   - Validation: promoStartAt must be < promoEndAt (enforced in the
  //     PUT /api/admin/settings route, not at the DB layer).
  promoActive         Boolean   @default(false)
  promoTitle           String    @default("")    // e.g. "Promo 50%"
  promoStartAt         DateTime?                  // UTC; input UI = Asia/Jakarta
  promoEndAt           DateTime?                  // UTC; input UI = Asia/Jakarta
  promoCountdown       Boolean   @default(true)   // show live countdown?
  promoTextBefore      String    @default("")    // "Promo 50% mulai dalam"
  promoTextDuring      String    @default("")    // "🔥 Promo 50% khusus hari ini"
  promoLink            String    @default("")    // optional CTA link
  updatedAt           DateTime @updatedAt
}
