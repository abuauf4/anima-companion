// Anima Companion — Prisma Schema
// PostgreSQL untuk dev & production (Supabase / Neon / Vercel Postgres).
//
// Phase 3 (Neon migration readiness):
// - `url`       → DATABASE_URL  (Neon pooled connection via PgBouncer, for runtime)
// - `directUrl` → DIRECT_URL    (Neon direct connection, for migrations/introspection/admin)
// Prisma 6.x supports `directUrl` natively (introduced in 5.10). Both env vars
// MUST be set in production. See `.env.example` for the correct format.
//
// ===========================================================================
// SCHEMA DEPLOYMENT STRATEGY — schema-push (prisma db push), NOT migrations
// ===========================================================================
// This project intentionally uses the schema-push workflow
// (`bun run db:push` → `prisma db push`) instead of the migration workflow
// (`prisma migrate dev` / `prisma migrate deploy`). There is intentionally
// NO `prisma/migrations/` directory and NO `_prisma_migrations` table.
//
// WHY (historical context, see worklog.md Phase 3):
//   - The existing Supabase production database was the source of truth
//     at the time of the Neon migration readiness work. The schema was
//     introspected against production, compared with this file, and
//     pushed with `prisma db push` to align dev/staging/prod to the
//     same shape. Generating a synthetic migration baseline from a
//     pre-existing database is fragile and `prisma migrate` would have
//     falsely recorded a sequence of `migration.sql` files that never
//     actually ran in order on the production DB.
//   - The team chose to keep `prisma db push` going forward and to
//     document schema-level changes via commit history + the SQL
//     reference files in `prisma/sql/` rather than via `_prisma_migrations`.
//
// WHAT THIS MEANS FOR OPERATORS:
//   - To apply schema changes to any environment (dev/staging/prod),
//     run `bun run db:push` (or `bunx prisma db push` against the
//     target DATABASE_URL). Prisma will compute the diff between this
//     schema file and the target DB and apply the minimal DDL.
//   - The `db:migrate` script (`prisma migrate dev`) exists in
//     package.json but is intentionally unused. Running it would
//     create a `prisma/migrations/` directory and a `_prisma_migrations`
//     table on the target DB, which would conflict with the schema-push
//     workflow. Do NOT switch workflows without a coordinated migration
//     plan that exports the existing DB state as the baseline migration.
//   - For audit / paper-trail purposes, every schema-affecting commit
//     SHOULD also commit a corresponding SQL reference file under
//     `prisma/sql/<YYYYMMDD>-<slug>.sql` showing the DDL that `db push`
//     would have applied. These files are NOT Prisma migrations and are
//     NOT picked up by `prisma migrate` — they exist purely so an
//     operator can review / replay the DDL by hand if needed.
//
// VERIFICATION (how to verify schema parity without running migrations):
//   - `bunx prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-url $DATABASE_URL`
//     prints the SQL that `db push` WOULD apply to bring the target DB
//     in line with the schema. If the output is empty, the DB is already
//     in sync. Use this in CI / pre-deploy checks.
//   - `bunx prisma migrate diff --from-url $DATABASE_URL --to-schema-datamodel prisma/schema.prisma`
//     prints the inverse diff — useful for detecting drift in the other
//     direction (DB has columns the schema doesn't, or vice versa).
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== USER & AUTH ====================
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  phone           String?
  role            String   @default("CUSTOMER") // CUSTOMER | ADMIN | SELLER
  // === Verified Identity V1 ===
  // Identity provider for this account:
  //   PASSWORD — local email/password (default, backwards-compatible with
  //              existing rows created before Verified Identity V1).
  //   GOOGLE   — account created via Google Sign-In; email is considered
  //              verified by Google's identity-provider assertion.
  provider        String   @default("PASSWORD")
  // For GOOGLE users: the stable Google `sub` claim. NULL for PASSWORD
  // users. Unique when set, so a single Google identity can map to at
  // most one Anima Companion account.
  providerSubject  String?  @unique
  // Authoritative email-verification timestamp. NULL means unverified.
  // For PASSWORD users this is set ONLY by the email-verification flow
  // (POST /api/auth/verify-email/confirm with a valid token). For GOOGLE
  // users this is set at account-creation time, because Google's
  // `email_verified` claim is the trusted authority.
  // NEVER set this from a client request body — only from trusted server
  // flows (token verification / OAuth callback).
  emailVerifiedAt  DateTime?
  // === Account Recovery & Verification V2 ===
  // Monotonically-increasing version number for the user's session
  // authority. Encoded into the HMAC session cookie at sign time and
  // re-checked at every `getCurrentUser()` call. Bumped on password reset
  // (and any other credential-changing event) so all sessions issued
  // before the bump are immediately invalid — the user must re-authenticate
  // with the new credentials. Defaults to 0 so existing rows are
  // backwards-compatible. NEVER read from a client request body — only
  // the server-side reset-password flow increments this.
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart             Cart?
  orders           Order[]
  reviews          Review[]
  petProfiles      PetProfile[]
  wishlist         Wishlist[]
  seller           Seller?
  verificationTokens EmailVerificationToken[]
  otpCodes         OtpCode[]
  passwordResetGrants PasswordResetGrant[]
}

// ==================== EMAIL VERIFICATION TOKENS ====================
// Single-use, time-limited tokens for proving control of an email address
// during PASSWORD registration. GOOGLE users do not use this table — their
// email is verified by Google's identity provider at account-creation
// time and `emailVerifiedAt` is set directly.
//
// SECURITY CONTRACT:
//   - The raw token is 32 bytes of CSPRNG output, hex-encoded (64 chars).
//   - The DB stores only `sha256(rawToken)` as `tokenHash` — a DB
//     compromise does NOT reveal active tokens.
//   - `expiresAt` is 24h after creation.
//   - `consumedAt` is NULL until the token is consumed by the verify
//     route. Once non-NULL the token can never be used again.
//   - On requesting a new verification email, all UNCONSUMED tokens for
//     the same user are invalidated by setting `consumedAt = now()` —
//     only the newest token is valid at any time.
//   - Concurrency-safe consumption: the verify route uses
//     `updateMany WHERE consumedAt IS NULL AND expiresAt > now()` and
//     checks `count === 1` — only one of two concurrent requests with
//     the same token can win. The loser returns the same success
//     response (idempotent outcome: `emailVerifiedAt` is set either way).
model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  // SHA-256 hex of the raw 32-byte token. Never store the raw token.
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== OTP CODES (Account Recovery & Verification V2) ====================
// 6-digit one-time passwords for (a) email verification on new PASSWORD
// registrations and (b) password-reset identity proof. Replaces the V1
// link-based EmailVerificationToken flow for new issuances — V1 tokens
// already in the DB remain valid until consumed or expired, but new
// requests use this OTP table.
//
// SECURITY CONTRACT:
//   - The raw 6-digit code is NEVER stored. The DB stores only
//     `codeHash = HMAC-SHA-256(code, secret)` where `secret` is the
//     server's AUTH_SECRET (same secret used to sign session cookies).
//     HMAC (not plain SHA-256) is mandatory because the 6-digit code
//     space is only 10^6 — without a server-secret pepper, a DB-leak
//     attacker could brute-force the hash in microseconds. With the
//     HMAC pepper, the attacker must know AUTH_SECRET to mount even an
//     offline brute force.
//   - `purpose` discriminates email-verification OTPs from password-reset
//     OTPs so a code issued for one flow cannot be redeemed in the other.
//   - `attempts` counts failed verification attempts against this code.
//     When `attempts >= maxAttempts` (default 5), the code is LOCKED —
//     further verification attempts return `LOCKED` and the user must
//     request a new code (subject to the 60s resend cooldown).
//   - `expiresAt` is 10 minutes after creation (V2 spec).
//   - `lastSentAt` records when the most recent EMAIL carrying this code
//     was dispatched. The resend-cooldown check is
//     `now - lastSentAt < 60s` → reject the resend. This is enforced
//     server-side, not client-side, so a malicious client cannot bypass it.
//   - `consumedAt` is NULL until the code is successfully verified.
//     Once set, the code can never be used again — single-use enforcement.
//   - On requesting a new OTP, all UNCONSUMED OTPs for the same
//     (userId, purpose) pair are invalidated by setting `consumedAt = now()`
//     AND `attempts = maxAttempts` (so a partially-attacked old code can't
//     be revived). Only the newest OTP is valid at any time.
//   - Concurrency-safe consumption: the verify path uses an interactive
//     `db.$transaction(async (tx) => { ... })` that (1) looks up the
//     newest unconsumed OTP for the (userId, purpose) pair inside the tx,
//     (2) atomically claims it via `updateMany WHERE id = row.id AND
//     consumedAt IS NULL AND expiresAt > now AND attempts < maxAttempts`,
//     (3) GATES on `claim.count === 1` — if the claim lost the race (a
//     concurrent verify won it, or a new OTP was issued between lookup
//     and claim, or the code expired between lookup and claim, or the
//     attempts just hit maxAttempts), NO further mutation happens.
//     Only when `claim.count === 1` does the verify proceed to its
//     purpose-specific side effect (set emailVerifiedAt, or issue a
//     PasswordResetGrant).
//   - On a WRONG code (hash mismatch), `attempts` is incremented inside
//     the SAME transaction. Two concurrent wrong-code requests can race,
//     but the `updateMany WHERE id = row.id AND attempts < maxAttempts`
//     re-asserts the cap atomically — when attempts hits maxAttempts,
//     further wrong-code requests return LOCKED without incrementing
//     past the cap. The cap is hard.
model OtpCode {
  id          String    @id @default(cuid())
  userId      String
  // 'EMAIL_VERIFICATION' | 'PASSWORD_RESET'. Discriminates the two OTP
  // flows so a code issued for one cannot be redeemed in the other.
  purpose     String
  // HMAC-SHA-256(code, AUTH_SECRET) — hex digest. The raw 6-digit code
  // is NEVER persisted. See the SECURITY CONTRACT above for why HMAC
  // (not plain SHA-256) is mandatory for a 6-digit code space.
  codeHash    String
  // Failed verification attempts against THIS code. When this reaches
  // `maxAttempts`, the code is LOCKED — the user must request a new one.
  attempts    Int       @default(0)
  // Denormalized cap (default 5) for auditability — could be tuned per
  // purpose in the future without a schema change.
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  // NULL until successfully consumed (single-use enforcement).
  consumedAt  DateTime?
  // When the most recent EMAIL carrying this code was dispatched. The
  // 60-second resend cooldown is `now - lastSentAt < 60s`.
  lastSentAt  DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ==================== PASSWORD RESET GRANTS (V2) ====================
// Short-lived, single-use grants issued AFTER a valid password-reset OTP
// consumption. The raw grant is a 32-byte CSPRNG hex string delivered
// to the user's email OR returned to the OTP-verify response (the route
// will decide; current V2 plan: returned in the verify-OTP response,
// then submitted by the reset-password form).
//
// SECURITY CONTRACT:
//   - The raw grant is 32 bytes of CSPRNG output, hex-encoded (64 chars).
//   - The DB stores only `sha256(rawGrant)` as `grantHash` — a DB
//     compromise does NOT reveal active grants. SHA-256 is sufficient
//     here (unlike the 6-digit OTP) because the input is 32 bytes of
//     CSPRNG entropy — already brute-force-infeasible.
//   - `expiresAt` is 10 minutes after creation (V2 spec — short-lived).
//   - `consumedAt` is NULL until the grant is consumed by the
//     reset-password route. Once set, the grant can never be used again.
//   - Concurrency-safe consumption: the reset-password route uses
//     `updateMany WHERE consumedAt IS NULL AND expiresAt > now()` and
//     checks `count === 1` — only one of two concurrent requests with
//     the same grant can win. The loser is rejected.
//   - On successful consumption, the route atomically (in the SAME
//     interactive transaction) (a) sets the new bcrypt password,
//     (b) bumps `User.sessionVersion` (invalidating all prior sessions),
//     (c) marks the grant as consumed.
//   - A successful password reset ALSO invalidates all unconsumed OTPs
//     for the user (any purpose) by setting `consumedAt = now()` — so
//     a partially-attacked password-reset OTP cannot be used after the
//     password is changed.
model PasswordResetGrant {
  id          String    @id @default(cuid())
  userId      String
  // SHA-256 hex of the raw 32-byte grant. Never store the raw grant.
  grantHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PetProfile {
  id        String   @id @default(cuid())
  userId    String
  petName   String
  petTypeId String
  age       String   // "2 tahun" / "6 bulan"
  weight    String   // "4.5 kg"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petType   PetType  @relation(fields: [petTypeId], references: [id])

  @@index([userId])
}

// ==================== SELLER / BRAND (MARKETPLACE) ====================
model Seller {
  id          String   @id @default(cuid())
  userId      String?  @unique // jika seller punya akun login
  name        String   // nama brand/toko
  slug        String   @unique
  logo        String?
  banner      String?
  tagline     String?
  description String?
  rating      Float    @default(5.0)
  totalSales  Int      @default(0)
  location    String?
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  products    Product[]
}

// ==================== CATALOG ====================
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products  Product[]
}

model PetType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  products       ProductPetType[]
  petProfiles    PetProfile[]
}

model Problem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())

  products    ProductProblem[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  sku             String    @unique
  brand           String    // brand label (string, e.g. "Zesty Paws", "Native Pet")
  sellerId        String?   // relasi ke Seller (marketplace)
  price           Int       // dalam Rupiah penuh
  salePrice       Int?
  subscribePrice  Int?      // harga subscribe & save (lebih murah)
  stock           Int       @default(0)
  weight          String?
  description     String
  benefit         String
  usage           String
  ingredients     String
  bpomNumber      String?
  isBestSeller    Boolean   @default(false)
  isNew           Boolean   @default(false)
  isSubscribeEligible Boolean @default(false) // eligible untuk Subscribe & Save
  rating          Float     @default(5.0)
  reviewCount     Int       @default(0)
  isActive        Boolean   @default(true)
  categoryId      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id])
  seller          Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  petTypes        ProductPetType[]
  problems        ProductProblem[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlist        Wishlist[]

  @@index([categoryId])
  @@index([slug])
  @@index([sellerId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPetType {
  productId String
  petTypeId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  petType   PetType  @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([productId, petTypeId])
}

model ProductProblem {
  productId String
  problemId String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([productId, problemId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  userName  String
  rating    Int
  comment   String
  petType   String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ==================== CART & WISHLIST ====================
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  isSubscribe Boolean @default(false) // apakah item ini pakai subscribe & save
  createdAt DateTime @default(now())

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ==================== VOUCHER ====================
model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // PERCENTAGE | FIXED
  value       Int
  minSpend    Int       @default(0)
  isActive    Boolean   @default(true)
  validUntil  DateTime?
  description String?
  createdAt   DateTime  @default(now())
}

// ==================== ORDER ====================
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  userId        String?
  status        String   @default("PENDING")
  customerName  String
  customerPhone String
  address       String
  notes         String?
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  voucherCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  price       Int
  quantity    Int
  subtotal    Int

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ==================== CONTENT ====================
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  link      String?
  position  String   @default("HOME")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  petName   String
  petType   String
  message   String
  rating    Int      @default(5)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
}

// ==================== SITE SETTINGS (SINGLETON) ====================
model SiteSetting {
  id                  String   @id @default("singleton")
  // Hero
  heroEyebrow         String   @default("Suplemen & Vitamin Hewan Peliharaan")
  heroTitle1          String   @default("Elevating")
  heroTitle2          String   @default("Animal Health")
  heroDescription     String   @default("Suplemen & vitamin hewan peliharaan premium dari Anima Companion — PT Sutan Vet Medika. Tersedia di 515+ klinik seluruh Indonesia.")
  heroHookTitle1      String   @default("Belanja sesuai")
  heroHookTitle2      String   @default("hewan peliharaanmu")
  // Trust badges
  trustBadge1Value    String   @default("50rb+")
  trustBadge1Label    String   @default("Pelanggan")
  trustBadge2Value    String   @default("515+")
  trustBadge2Label    String   @default("Klinik Resmi")
  trustBadge3Value    String   @default("4.9★")
  trustBadge3Label    String   @default("Rating")
  trustBadge4Value    String   @default("24/7")
  trustBadge4Label    String   @default("Konsul Vet")
  // Contact
  whatsappNumber      String   @default("6282210846408")
  email               String   @default("hello@animacompanion.id")
  instagram           String   @default("@anima.companion")
  instagramUrl        String   @default("https://instagram.com/anima.companion")
  shopeeUrl           String   @default("https://shopee.co.id/anima.companion")
  tokopediaUrl        String   @default("https://www.tokopedia.com/find/felcover")
  tiktokUrl           String   @default("")
  // Announcement bar
  announcement1       String   @default("🚚 Gratis ongkir min Rp 150.000")
  announcement2       String   @default("⏰ Flash Sale 20% — berakhir segera!")
  announcement3       String   @default("🎁 Subscribe & Save hemat 15% setiap pesanan")
  announcement4       String   @default("🩺 Konsultasi vet gratis 24/7 via WhatsApp")
  // Misc
  freeShippingThreshold Int     @default(150000)
  updatedAt           DateTime @updatedAt
}
